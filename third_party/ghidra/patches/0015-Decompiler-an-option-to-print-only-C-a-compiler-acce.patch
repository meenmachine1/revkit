+/// The expression is `*(T *)((char *)&x.f + off)`, where `x.f` is the symbol and the fields resolved
+/// so far, and T is the Varnode's type (or an undefined type of its size): an lvalue C accepts for the
+/// bytes no field names, in place of the artificial `x.f._off_size_`.
+/// \param sym is the symbol
+/// \param stack is the fields and subscripts resolved before the bytes
+/// \param off is the offset of the bytes within the last resolved field
+/// \param sz is the number of bytes
+/// \param vn is the Varnode accessing the bytes
+/// \param op is the PcodeOp accessing the bytes
+void PrintC::pushBytesAt(const Symbol *sym,const vector<PartialSymbolEntry> &stack,int4 off,int4 sz,
+			 const Varnode *vn,const PcodeOp *op)
+{
+  TypeFactory *types = glb->types;
+  Datatype *ct = vn->isAnnotation() ? (Datatype *)0 : vn->getHigh()->getType();
+  if (ct == (Datatype *)0 || ct->getSize() != sz || ct->getMetatype() == TYPE_PARTIALSTRUCT ||
+      ct->getMetatype() == TYPE_PARTIALUNION || ct->getMetatype() == TYPE_PARTIALENUM)
+    ct = types->getBase(sz,TYPE_UNKNOWN);
+  uint4 wordSize = glb->getDefaultDataSpace()->getWordSize();
+  Datatype *ptrType = types->getTypePointer(types->getSizeOfPointer(),ct,wordSize);
+  pushOp(&dereference,op);
+  pushOp(&typecast,op);
+  pushType(ptrType);
+  if (off != 0) {
+    pushOp(&binary_plus,op);
+    pushOp(&typecast,op);
+    pushType(types->getTypePointer(types->getSizeOfPointer(),types->getTypeChar(1),wordSize));
+  }
+  pushOp(&addressof,op);
+  for(int4 i=stack.size()-1;i>=0;--i)
+    pushOp(stack[i].token,op);
+  pushSymbol(sym,vn,op);
+  for(int4 i=0;i<stack.size();++i) {
+    const PartialSymbolEntry &entry (stack[i]);
+    if (entry.field == (const TypeField *)0)
+      push_integer(entry.offset, entry.size, (entry.offset < 0), syntax, (Varnode *)0, op, 0);
+    else
+      pushAtom(Atom(entry.field->name,fieldtoken,entry.hilite,entry.parent,entry.field->ident,op));
+  }
+  if (off != 0)
+    push_integer(off,4,false,syntax,(Varnode *)0,op,Symbol::force_dec);
+}
