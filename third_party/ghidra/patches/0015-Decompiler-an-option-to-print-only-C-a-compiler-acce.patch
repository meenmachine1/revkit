+/// \class OptionCompilable
+/// \brief Toggle whether the decompiler prints only C a compiler accepts
+///
+/// Setting the first parameter to "on" changes what a C compiler would reject:
+///   - bytes of a variable no field names print as `*(T *)((char *)&x + 2)` rather than `x._2_2_`,
+///     and a variable read wider than its symbol as `*(T *)&x` rather than `_x`
+///   - a label or the last \e case of a \e switch with no statement after it gets an empty statement
+///   - a conversion between a pointer and an integer, or between pointers to different kinds of
+///     data, gets a cast
+string OptionCompilable::apply(Architecture *glb,const string &p1,const string &p2,const string &p3) const
+
+{
+  bool val = onOrOff(p1);
+  if (glb->print->getName() != "c-language")
+    return "Only c-language accepts the compilable option";
+  PrintC *lng = (PrintC *)glb->print;
+  lng->setCompilable(val);
+  string prop;
+  prop = val ? "on" : "off";
+  return "Compilable C turned "+prop;
+}
+
