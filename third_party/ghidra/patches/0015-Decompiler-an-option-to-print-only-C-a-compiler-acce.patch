+/// \brief Is the given meta-type an integer, as far as conversions to and from pointers go
+///
+/// \param meta is the given meta-type
+/// \return \b true for integer, boolean, enumerated and undefined meta-types
+static bool isIntegerMeta(type_metatype meta)
+
+{
+  return (meta == TYPE_INT || meta == TYPE_UINT || meta == TYPE_UNKNOWN || meta == TYPE_BOOL ||
+	  meta == TYPE_ENUM_INT || meta == TYPE_ENUM_UINT);
+}
