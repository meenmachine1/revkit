+
+/// A basic block (or a copy of one) prints nothing when every op in it is unprinted, implied or
+/// a plain branch, which the block structure prints if needed.
+/// \param bl is the given block
+/// \return \b true if the block prints no statement
+bool PrintC::printsNothing(const FlowBlock *bl) const
+
+{
+  if (bl->getType() == FlowBlock::t_copy)
+    bl = bl->subBlock(0);
+  if (bl->getType() != FlowBlock::t_basic)
+    return false;
+  const BlockBasic *bb = (const BlockBasic *)bl;
+  list<PcodeOp *>::const_iterator iter;
+  for(iter=bb->beginOp();iter!=bb->endOp();++iter) {
+    const PcodeOp *inst = *iter;
+    if (inst->notPrinted()) continue;
+    if (inst->code() == CPUI_BRANCH) continue;
+    const Varnode *vn = inst->getOut();
+    if ((vn!=(const Varnode *)0)&&(vn->isImplied()))
+      continue;
+    return false;
+  }
+  return true;
 }
 
 /// The block does not have to be a basic block.  This routine finds the entry basic
