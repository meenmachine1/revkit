+/// \class RuleFlagResultCompare
+/// \brief Simplify a signed flag test of a result back to a comparison of the result
+///
+/// A subtract that sets the flags followed by a signed greater-than branch (ARM `subs r2,r2,#1; bgt`)
+/// tests `W != 0 && c < V`, where `W = V + d` is the result and the comparison is on the value before.
+/// When `c + d` is -1 this is `0 < W` (`W > 0`, the test the instruction encodes), and its negation
+/// `W == 0 || V < c'`, with `c' + d` equal to 0, is `W <= 0`:
+///   - `(V + d != 0) && (c < V)  =>  0 < V + d`
+///   - `(V + d == 0) || (V < c)  =>  V + d <= 0`
+///
+/// The less-or-equal forms `c+1 <= V` and `V <= c'-1` are also matched. The rule assumes the
+/// decrement doesn't overflow (V isn't within d of the minimum), as the source's `--n > 0` does.
+/// It applies only with the \e flagcompare option.
+void RuleFlagResultCompare::getOpList(vector<uint4> &oplist) const
+
+{
+  oplist.push_back(CPUI_BOOL_AND);
+  oplist.push_back(CPUI_BOOL_OR);
+}
+
+/// \brief Is the given result the given base plus a constant
+///
+/// \param res is the possible result
+/// \param base is the possible base
+/// \param d passes back the constant
+/// \return \b true if \b res is INT_ADD(\b base, d)
+bool RuleFlagResultCompare::decrementOf(Varnode *res,Varnode *base,uintb &d)
+
+{
+  if (!res->isWritten()) return false;
+  PcodeOp *addop = res->getDef();
+  if (addop->code() != CPUI_INT_ADD) return false;
+  if (addop->getIn(0) != base) return false;
+  Varnode *cvn = addop->getIn(1);
+  if (!cvn->isConstant()) return false;
+  d = cvn->getOffset();
+  return true;
+}
+
+int4 RuleFlagResultCompare::applyOp(PcodeOp *op,Funcdata &data)
+
+{
+  if (!data.getArch()->flag_result_compare) return 0;
+  bool isAnd = (op->code() == CPUI_BOOL_AND);
+  for(int4 i=0;i<2;++i) {
+    Varnode *eqout = op->getIn(i);
+    Varnode *cmpout = op->getIn(1-i);
+    if (!eqout->isWritten() || !cmpout->isWritten()) continue;
+    PcodeOp *eqop = eqout->getDef();
+    if (eqop->code() != (isAnd ? CPUI_INT_NOTEQUAL : CPUI_INT_EQUAL)) continue;
+    Varnode *res = eqop->getIn(0);
+    Varnode *zero = eqop->getIn(1);
+    if (!zero->isConstant() || zero->getOffset() != 0) continue;
+    PcodeOp *cmpop = cmpout->getDef();
+    OpCode opc = cmpop->code();
+    if (opc != CPUI_INT_SLESS && opc != CPUI_INT_SLESSEQUAL) continue;
+    // AND: c < V or c <= V (the constant first); OR: V < c or V <= c (the constant last)
+    int4 cslot = isAnd ? 0 : 1;
+    Varnode *cvn = cmpop->getIn(cslot);
+    Varnode *base = cmpop->getIn(1-cslot);
+    if (!cvn->isConstant()) continue;
+    uintb d;
+    if (!decrementOf(res,base,d)) continue;
+    int4 sz = res->getSize();
+    uintb mask = calc_mask(sz);
+    uintb sum = (cvn->getOffset() + d) & mask;
+    uintb want;
+    if (isAnd)
+      want = (opc == CPUI_INT_SLESS) ? mask : 0;	// c + d == -1 (c < V), or 0 (c <= V)
+    else
+      want = (opc == CPUI_INT_SLESS) ? 0 : mask;	// c + d == 0 (V < c), or -1 (V <= c)
+    if (sum != want) continue;
+    if (isAnd) {		// 0 < W
+      data.opSetOpcode(op,CPUI_INT_SLESS);
+      data.opSetInput(op,data.newConstant(sz,0),0);
+      data.opSetInput(op,res,1);
+    }
+    else {			// W <= 0
+      data.opSetOpcode(op,CPUI_INT_SLESSEQUAL);
+      data.opSetInput(op,res,0);
+      data.opSetInput(op,data.newConstant(sz,0),1);
+    }
+    return 1;
+  }
+  return 0;
+}
+
