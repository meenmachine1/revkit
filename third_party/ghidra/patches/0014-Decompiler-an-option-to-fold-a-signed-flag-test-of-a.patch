+/// \class OptionFlagCompare
+/// \brief Toggle whether a signed flag test of a decrement's result becomes one comparison
+///
+/// Setting the first parameter to "on" turns `W != 0 && c < V`, where `W = V + d` and `c + d` is -1
+/// (what `subs r2,r2,#1; bgt` tests), into `0 < W`, and its negation, `W == 0 || V < c'` with `c' + d`
+/// equal to 0, into `W <= 0`
+/// (RuleFlagResultCompare). The rewrite assumes the decrement doesn't overflow, as source code
+/// counting down (`while (--n > 0)`) does.
+string OptionFlagCompare::apply(Architecture *glb,const string &p1,const string &p2,const string &p3) const
+
+{
+  glb->flag_result_compare = onOrOff(p1);
+
+  string res = "Comparing flag results is " + p1;
+  return res;
+}
+
