+/// \brief Can the constant input of a comparison be printed one away from its value
+///
+/// The constant must be a plain integer (no equate or other symbol, not a character, enum or pointer),
+/// and moving it must not wrap: one less than the minimum or one more than the maximum of its type.
+/// \param vn is the constant input
+/// \param op is the comparison
+/// \param plus is \b true to move it up by one, \b false to move it down
+/// \return \b true if the constant can move
+static bool canMoveCompareConstant(const Varnode *vn,const PcodeOp *op,bool plus)
+
+{
+  if (vn->getSymbolEntry() != (SymbolEntry *)0) return false;
+  Datatype *ct = vn->getHighTypeReadFacing(op);
+  type_metatype meta = ct->getMetatype();
+  if (meta != TYPE_INT && meta != TYPE_UINT && meta != TYPE_UNKNOWN) return false;
+  if (ct->isCharPrint() || ct->isEnumType()) return false;
+  int4 sz = vn->getSize();
+  uintb val = vn->getOffset();
+  bool isSigned = (op->code() == CPUI_INT_SLESS || op->code() == CPUI_INT_SLESSEQUAL);
+  if (isSigned) {
+    if (plus && val == calc_int_max(sz)) return false;
+    if (!plus && val == calc_int_min(sz)) return false;
+  }
+  else {
+    if (plus && val == calc_mask(sz)) return false;
+    if (!plus && val == 0) return false;
+  }
+  return true;
+}
+
+/// Without the \e encodedcompare option, this is a normal binary operator. Set to \e right, a
+/// comparison against a constant prints the constant on the right (`x > 8` rather than `8 < x`), and a
+/// signed `-1 < x` as the sign test it is, `x >= 0`. Set to \e on, also a comparison whose constant
+/// was moved by one when its \e less-or-equal form became \e less (Funcdata::replaceLessequal, which
+/// records the move on the op) prints in the \e less-or-equal form, with the constant the instruction
+/// encodes: `x <= 0` rather than `x < 1`, `x >= 9` rather than `8 < x`.
+/// \param tok is the operator token of the comparison as it stands
+/// \param op is the comparison
+void PrintC::opComparison(const OpToken *tok,const PcodeOp *op)
+
+{
+  if (option_compare_form == 0) {
+    opBinary(tok,op);
+    return;
+  }
+  const Varnode *in0 = op->getIn(0);
+  const Varnode *in1 = op->getIn(1);
+  int4 cslot;
+  if (in1->isConstant())
+    cslot = 1;
+  else if (in0->isConstant())
+    cslot = 0;
+  else {
+    opBinary(tok,op);
+    return;
+  }
+  uint4 adjust = 0;
+  if (option_compare_form == 2 && op->isLessEqualMoved() && tok == &less_than) {
+    // V < c was V <= c-1, and c < V was c+1 <= V
+    if (canMoveCompareConstant(op->getIn(cslot),op,cslot == 0)) {
+      tok = &less_equal;
+      adjust = (cslot == 1) ? const_minus_one : const_plus_one;
+    }
+  }
+  else if (op->code() == CPUI_INT_SLESS && cslot == 0 && in0->getOffset() == calc_mask(in0->getSize()) &&
+	   canMoveCompareConstant(in0,op,true)) {
+    tok = &less_equal;		// -1 < V is V >= 0, a sign test
+    adjust = const_plus_one;
+  }
+  if (cslot == 0)		// The constant goes on the right: c < V is V > c
+    tok = (tok == &less_than) ? &greater_than : &greater_equal;
+  if (isSet(negatetoken)) {
+    tok = tok->negate;
+    unsetMod(negatetoken);
+  }
+  pushOp(tok,op);
+  // Inputs are pushed in reverse order of printing
+  if (cslot == 0) {
+    pushVn(in0,op,mods | adjust);
+    pushVn(in1,op,mods);
+  }
+  else {
+    pushVn(in1,op,mods | adjust);
+    pushVn(in0,op,mods);
+  }
+}
