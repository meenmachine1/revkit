+/// \class OptionEncodedCompare
+/// \brief Set whether comparisons print in the form the instruction encodes
+///
+/// The first parameter is "right" to print a comparison against a constant with the constant on
+/// the right (`x > 8` rather than `8 < x`, `x >= 0` rather than `-1 < x`), "on" to also print it
+/// with the constant the code compares against where the decompiler moved it by one to turn
+/// \e less-or-equal into \e less (`x <= 0` and `x >= 9` rather than `x < 1` and `8 < x`), or "off".
+/// Compilers that rewrite `x < 10` as `x <= 9` themselves (GCC, LLVM) encode a constant the source
+/// doesn't have, so "right" suits their code and "on" a compiler that keeps the source's.
+string OptionEncodedCompare::apply(Architecture *glb,const string &p1,const string &p2,const string &p3) const
+
+{
+  int4 form;
+  if (p1 == "right")
+    form = 1;
+  else
+    form = onOrOff(p1) ? 2 : 0;
+  if (glb->print->getName() != "c-language")
+    return "Only c-language accepts the encoded comparison option";
+  PrintC *lng = (PrintC *)glb->print;
+  lng->setCompareForm(form);
+  string prop = (form == 2) ? "on" : (form == 1) ? "right" : "off";
+  return "Encoded comparisons turned "+prop;
+}
+
 /// \class OptionInPlaceOps
 /// \brief Toggle whether \e in-place operators (+=, *=, &=, etc.) are emitted by the decompiler
 string OptionInPlaceOps::apply(Architecture *glb,const string &p1,const string &p2,const string &p3) const
