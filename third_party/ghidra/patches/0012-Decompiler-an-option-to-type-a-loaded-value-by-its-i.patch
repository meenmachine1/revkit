diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/flow.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/flow.cc
index 0add3cc..01ed44d 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/flow.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/flow.cc
@@ -380,6 +380,42 @@ PcodeOp *FlowInfo::xrefControlFlow(list<PcodeOp *>::const_iterator oiter,bool &s
 /// \param curaddr is the address of the instruction to process
 /// \param startbasic indicates of the instruction starts a basic block and passes back whether the next instruction does
 /// \return \b true if the processed instruction has a fall-thru flow
+/// \brief Mark each LOAD of an instruction with the extension the instruction applies to its value
+///
+/// A LOAD whose output the same instruction reads with INT_SEXT is marked as sign-extending, and one
+/// read with INT_ZEXT, of a value smaller than an \e int, as zero-extending (a zero-extension of an
+/// \e int sized value is how some processors write a 32-bit result to a 64-bit register, not a choice
+/// of signedness). The p-code is not yet in SSA form, so the output and the read are matched by storage.
+/// \param oiter points to the first op of the instruction in the dead list
+void FlowInfo::markLoadExtensions(list<PcodeOp *>::const_iterator oiter)
+
+{
+  int4 intSize = glb->types->getSizeOfInt();
+  for(list<PcodeOp *>::const_iterator iter=oiter;iter!=obank.endDead();++iter) {
+    PcodeOp *op = *iter;
+    if (op->code() != CPUI_LOAD) continue;
+    const Varnode *outvn = op->getOut();
+    if (outvn == (const Varnode *)0) continue;
+    list<PcodeOp *>::const_iterator iter2 = iter;
+    for(++iter2;iter2!=obank.endDead();++iter2) {
+      PcodeOp *readop = *iter2;
+      OpCode opc = readop->code();
+      if (opc == CPUI_INT_SEXT || opc == CPUI_INT_ZEXT) {
+	const Varnode *invn = readop->getIn(0);
+	if (invn->getAddr() == outvn->getAddr() && invn->getSize() == outvn->getSize()) {
+	  if (opc == CPUI_INT_SEXT)
+	    op->setLoadExtension(true);
+	  else if (outvn->getSize() < intSize && (glb->extension_types == 1 || outvn->getSize() > 1))
+	    op->setLoadExtension(false);
+	  break;
+	}
+      }
+      Varnode *wr = readop->getOut();	// Stop where the loaded value is overwritten
+      if (wr != (Varnode *)0 && wr->getAddr() == outvn->getAddr()) break;
+    }
+  }
+}
+
 bool FlowInfo::processInstruction(const Address &curaddr,bool &startbasic)
 
 {
@@ -471,6 +507,8 @@ bool FlowInfo::processInstruction(const Address &curaddr,bool &startbasic)
   if (oiter != obank.endDead()) {
     stat.seqnum = (*oiter)->getSeqNum();
     data.opMarkStartInstruction(*oiter); // Mark the first op in the instruction
+    if (glb->extension_types != 0)
+      markLoadExtensions(oiter);
     if (flowoverride != Override::NONE)
       data.overrideFlow(curaddr,flowoverride);
     xrefControlFlow(oiter,startbasic,isfallthru,(FuncCallSpecs *)0);
