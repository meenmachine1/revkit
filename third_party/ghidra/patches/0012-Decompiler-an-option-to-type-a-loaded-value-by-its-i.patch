   behave = new OpBehavior(CPUI_LOAD,false,true); // Dummy behavior
 }
 
+/// A LOAD marked with the extension its instruction applies (see the \e extensiontypes option)
+/// produces a signed or unsigned integer; otherwise its output is unknown.
+Datatype *TypeOpLoad::getOutputLocal(const PcodeOp *op) const
+
+{
+  int4 size = op->getOut()->getSize();
+  if (op->isSextLoad())
+    return tlst->getBase(size,TYPE_INT);
+  if (op->isZextLoad())
+    return tlst->getBase(size,TYPE_UINT);
+  return tlst->getBase(size,TYPE_UNKNOWN);
+}
