+/// \class OptionExtensionTypes
+/// \brief Toggle whether a loaded value is typed by the extension its instruction applies
+///
+/// Setting the first parameter to "on" makes a LOAD whose instruction sign-extends the value
+/// (\e ldrsh, \e movsx, \e lh) give it a signed integer type, and one whose instruction
+/// zero-extends a value smaller than an \e int (\e ldrh, \e movzx, \e lhu) an unsigned one,
+/// as the type of the LOAD's output in type propagation. The extension itself is usually
+/// simplified away before types are inferred (a value loaded, incremented and stored back
+/// at its own size), and the value is then typed by its other uses alone.
+/// "words" does the same except for a zero-extended byte: compilers load a signed \e char with
+/// \e movzx or \e ldrb where only its low bits matter, so the unsigned type would displace the
+/// \e char a string or a buffer has.
+string OptionExtensionTypes::apply(Architecture *glb,const string &p1,const string &p2,const string &p3) const
+
+{
+  if (p1 == "words")
+    glb->extension_types = 2;
+  else
+    glb->extension_types = onOrOff(p1) ? 1 : 0;
+
+  string res = "Typing loads by their extension is " + p1;
+  return res;
+}
+
 /// \class OptionForLoops
 /// \brief Toggle whether the decompiler attempts to recover \e for-loop variables
 ///
