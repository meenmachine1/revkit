b000d0e11eff2fe1
</bytechunk>
</binaryimage>
<script>
  <com>map fun r0x8068 half_cw</com>
  <com>map fun r0x8084 n_ret</com>
  <com>lo fu half_cw</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu n_ret</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option extensiontypes on</com>
  <com>lo fu half_cw</com>
  <com>decompile</com>
