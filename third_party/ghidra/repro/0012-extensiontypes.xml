<!--
  half_cw(p): p[0] = p[0] + 1 through ldrh/strh (unsigned: the instruction
  zero-extends), p[1] = (short)p[1] >> 1 through ldrsh/strh (signed).
    8068: ldrh r1,[r0]       806c: add r1,r1,#1      8070: strh r1,[r0]
    8074: ldrsh r1,[r0,#2]   8078: mov r1,r1,asr #1  807c: strh r1,[r0,#2]
    8080: bx lr
  n_ret(p): ldrh r0,[r0]; bx lr returns the unsigned short.
  Without extensiontypes the first is typed by its 2-byte add (short) and the
  second returns an undefined 2-byte type; with it, both follow the instructions.
-->
<binaryimage arch="ARM:LE:32:v5t:default">
