<script>
  <com>parse line struct rec { int2 a; int2 b; int2 c; int2 d; };</com>
  <com>map addr r0x10000 rec glob</com>
  <com>map addr r0x10010 int4 small</com>
  <com>map fun r0x1000 mid</com>
  <com>map fun r0x1010 wide</com>
  <com>map fun r0x1020 below</com>
  <com>parse line extern int4 mid(void);</com>
  <com>parse line extern int8 wide(void);</com>
  <com>parse line extern int4 below(char *p,uint8 n);</com>
  <com>lo fu mid</com>
