  wide():  mov rax,[0x10010]; ret  reads 8 bytes of a 4-byte int: _small
  below(p,n): cmp rdi,rsi; setb al; movzx eax,al; ret
                                   compares a pointer with an integer: no cast
  With compilablec: an lvalue C accepts for each, and the cast.
-->
