  <com>print C</com>
  <com>lo fu wide</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu below</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option compilablec on</com>
  <com>lo fu mid</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu wide</com>
  <com>decompile</com>
