:DUP6 is op=0x85 { local v:32 = *[opstack]:32 (SP + 160); push(v); }
:DUP7 is op=0x86 { local v:32 = *[opstack]:32 (SP + 192); push(v); }
:DUP8 is op=0x87 { local v:32 = *[opstack]:32 (SP + 224); push(v); }
:DUP9 is op=0x88 { local v:32 = *[opstack]:32 (SP + 256); push(v); }
:DUP10 is op=0x89 { local v:32 = *[opstack]:32 (SP + 288); push(v); }
:DUP11 is op=0x8a { local v:32 = *[opstack]:32 (SP + 320); push(v); }
:DUP12 is op=0x8b { local v:32 = *[opstack]:32 (SP + 352); push(v); }
:DUP13 is op=0x8c { local v:32 = *[opstack]:32 (SP + 384); push(v); }
:DUP14 is op=0x8d { local v:32 = *[opstack]:32 (SP + 416); push(v); }
:DUP15 is op=0x8e { local v:32 = *[opstack]:32 (SP + 448); push(v); }
:DUP16 is op=0x8f { local v:32 = *[opstack]:32 (SP + 480); push(v); }
:SWAP1 is op=0x90 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 32); *[opstack]:32 SP = b; *[opstack]:32 (SP + 32) = a; }
:SWAP2 is op=0x91 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 64); *[opstack]:32 SP = b; *[opstack]:32 (SP + 64) = a; }
:SWAP3 is op=0x92 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 96); *[opstack]:32 SP = b; *[opstack]:32 (SP + 96) = a; }
:SWAP4 is op=0x93 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 128); *[opstack]:32 SP = b; *[opstack]:32 (SP + 128) = a; }
:SWAP5 is op=0x94 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 160); *[opstack]:32 SP = b; *[opstack]:32 (SP + 160) = a; }
:SWAP6 is op=0x95 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 192); *[opstack]:32 SP = b; *[opstack]:32 (SP + 192) = a; }
:SWAP7 is op=0x96 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 224); *[opstack]:32 SP = b; *[opstack]:32 (SP + 224) = a; }
:SWAP8 is op=0x97 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 256); *[opstack]:32 SP = b; *[opstack]:32 (SP + 256) = a; }
:SWAP9 is op=0x98 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 288); *[opstack]:32 SP = b; *[opstack]:32 (SP + 288) = a; }
:SWAP10 is op=0x99 { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 320); *[opstack]:32 SP = b; *[opstack]:32 (SP + 320) = a; }
:SWAP11 is op=0x9a { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 352); *[opstack]:32 SP = b; *[opstack]:32 (SP + 352) = a; }
:SWAP12 is op=0x9b { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 384); *[opstack]:32 SP = b; *[opstack]:32 (SP + 384) = a; }
:SWAP13 is op=0x9c { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 416); *[opstack]:32 SP = b; *[opstack]:32 (SP + 416) = a; }
:SWAP14 is op=0x9d { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 448); *[opstack]:32 SP = b; *[opstack]:32 (SP + 448) = a; }
:SWAP15 is op=0x9e { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 480); *[opstack]:32 SP = b; *[opstack]:32 (SP + 480) = a; }
:SWAP16 is op=0x9f { local a:32 = *[opstack]:32 SP; local b:32 = *[opstack]:32 (SP + 512); *[opstack]:32 SP = b; *[opstack]:32 (SP + 512) = a; }

# Arithmetic and logic in p-code (sound below 2^64; see the header).
:ADD is op=0x1 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = a + b; push(r); }
:SUB is op=0x3 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = a - b; push(r); }
:AND is op=0x16 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = a & b; push(r); }
:OR is op=0x17 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = a | b; push(r); }
:XOR is op=0x18 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = a ^ b; push(r); }
:LT is op=0x10 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = zext(a < b); push(r); }
:GT is op=0x11 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = zext(a > b); push(r); }
:SLT is op=0x12 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = zext(a s< b); push(r); }
:SGT is op=0x13 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = zext(a s> b); push(r); }
:EQ is op=0x14 { local a:32 = 0; pop(a); local b:32 = 0; pop(b); local r:32 = zext(a == b); push(r); }
:ISZERO is op=0x15 { local a:32 = 0; pop(a); local r:32 = zext(a == 0); push(r); }
:NOT is op=0x19 { local a:32 = 0; pop(a); local r:32 = ~a; push(r); }

# Memory.
:MLOAD is op=0x51 { local o:32 = 0; pop(o); local a:4 = o:4; local v:32 = *[mem]:32 a; push(v); }
:MSTORE is op=0x52 { local o:32 = 0; pop(o); local v:32 = 0; pop(v); local a:4 = o:4; *[mem]:32 a = v; }
:MSTORE8 is op=0x53 { local o:32 = 0; pop(o); local v:32 = 0; pop(v); local a:4 = o:4; *[mem]:1 a = v:1; }

# The rest, as Yul names them.
:MUL is op=0x2 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = mul(x0, x1); push(r); }
:DIV is op=0x4 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = div(x0, x1); push(r); }
:SDIV is op=0x5 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = sdiv(x0, x1); push(r); }
:MOD is op=0x6 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = mod(x0, x1); push(r); }
:SMOD is op=0x7 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = smod(x0, x1); push(r); }
:ADDMOD is op=0x8 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local r:32 = addmod(x0, x1, x2); push(r); }
:MULMOD is op=0x9 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local r:32 = mulmod(x0, x1, x2); push(r); }
:EXP is op=0xa { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = exp(x0, x1); push(r); }
:SIGNEXTEND is op=0xb { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = signextend(x0, x1); push(r); }
:BYTE is op=0x1a { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = byte(x0, x1); push(r); }
:SHL is op=0x1b { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = shl(x0, x1); push(r); }
:SHR is op=0x1c { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = shr(x0, x1); push(r); }
:SAR is op=0x1d { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = sar(x0, x1); push(r); }
:KECCAK256 is op=0x20 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local r:32 = keccak256(x0, x1); push(r); }
:ADDRESS is op=0x30 { local r:32 = address(); push(r); }
:BALANCE is op=0x31 { local x0:32 = 0; pop(x0); local r:32 = balance(x0); push(r); }
:ORIGIN is op=0x32 { local r:32 = origin(); push(r); }
:CALLER is op=0x33 { local r:32 = caller(); push(r); }
:CALLVALUE is op=0x34 { local r:32 = callvalue(); push(r); }
:CALLDATALOAD is op=0x35 { local x0:32 = 0; pop(x0); local r:32 = calldataload(x0); push(r); }
:CALLDATASIZE is op=0x36 { local r:32 = calldatasize(); push(r); }
:CALLDATACOPY is op=0x37 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); calldatacopy(x0, x1, x2); }
:CODESIZE is op=0x38 { local r:32 = codesize(); push(r); }
:CODECOPY is op=0x39 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); codecopy(x0, x1, x2); }
:GASPRICE is op=0x3a { local r:32 = gasprice(); push(r); }
:EXTCODESIZE is op=0x3b { local x0:32 = 0; pop(x0); local r:32 = extcodesize(x0); push(r); }
:EXTCODECOPY is op=0x3c { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); extcodecopy(x0, x1, x2, x3); }
:RETURNDATASIZE is op=0x3d { local r:32 = returndatasize(); push(r); }
:RETURNDATACOPY is op=0x3e { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); returndatacopy(x0, x1, x2); }
:EXTCODEHASH is op=0x3f { local x0:32 = 0; pop(x0); local r:32 = extcodehash(x0); push(r); }
:BLOCKHASH is op=0x40 { local x0:32 = 0; pop(x0); local r:32 = blockhash(x0); push(r); }
:COINBASE is op=0x41 { local r:32 = coinbase(); push(r); }
:TIMESTAMP is op=0x42 { local r:32 = timestamp(); push(r); }
:NUMBER is op=0x43 { local r:32 = number(); push(r); }
:PREVRANDAO is op=0x44 { local r:32 = prevrandao(); push(r); }
:GASLIMIT is op=0x45 { local r:32 = gaslimit(); push(r); }
:CHAINID is op=0x46 { local r:32 = chainid(); push(r); }
:SELFBALANCE is op=0x47 { local r:32 = selfbalance(); push(r); }
:BASEFEE is op=0x48 { local r:32 = basefee(); push(r); }
:BLOBHASH is op=0x49 { local x0:32 = 0; pop(x0); local r:32 = blobhash(x0); push(r); }
:BLOBBASEFEE is op=0x4a { local r:32 = blobbasefee(); push(r); }
:SLOAD is op=0x54 { local x0:32 = 0; pop(x0); local r:32 = sload(x0); push(r); }
:SSTORE is op=0x55 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); sstore(x0, x1); }
:MSIZE is op=0x59 { local r:32 = msize(); push(r); }
:GAS is op=0x5a { local r:32 = gas(); push(r); }
:TLOAD is op=0x5c { local x0:32 = 0; pop(x0); local r:32 = tload(x0); push(r); }
:TSTORE is op=0x5d { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); tstore(x0, x1); }
:MCOPY is op=0x5e { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); mcopy(x0, x1, x2); }
:LOG0 is op=0xa0 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); log0(x0, x1); }
:LOG1 is op=0xa1 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); log1(x0, x1, x2); }
:LOG2 is op=0xa2 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); log2(x0, x1, x2, x3); }
:LOG3 is op=0xa3 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local x4:32 = 0; pop(x4); log3(x0, x1, x2, x3, x4); }
:LOG4 is op=0xa4 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local x4:32 = 0; pop(x4); local x5:32 = 0; pop(x5); log4(x0, x1, x2, x3, x4, x5); }
:CREATE is op=0xf0 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local r:32 = create(x0, x1, x2); push(r); }
:CALL is op=0xf1 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local x4:32 = 0; pop(x4); local x5:32 = 0; pop(x5); local x6:32 = 0; pop(x6); local r:32 = evm_call(x0, x1, x2, x3, x4, x5, x6); push(r); }
:CALLCODE is op=0xf2 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local x4:32 = 0; pop(x4); local x5:32 = 0; pop(x5); local x6:32 = 0; pop(x6); local r:32 = callcode(x0, x1, x2, x3, x4, x5, x6); push(r); }
:DELEGATECALL is op=0xf4 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local x4:32 = 0; pop(x4); local x5:32 = 0; pop(x5); local r:32 = delegatecall(x0, x1, x2, x3, x4, x5); push(r); }
:CREATE2 is op=0xf5 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local r:32 = create2(x0, x1, x2, x3); push(r); }
:STATICCALL is op=0xfa { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); local x2:32 = 0; pop(x2); local x3:32 = 0; pop(x3); local x4:32 = 0; pop(x4); local x5:32 = 0; pop(x5); local r:32 = staticcall(x0, x1, x2, x3, x4, x5); push(r); }

# The end of a run.
:STOP is op=0x0 { stop(); return [RA]; }
:RETURN is op=0xf3 { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); evm_return(x0, x1); return [RA]; }
:REVERT is op=0xfd { local x0:32 = 0; pop(x0); local x1:32 = 0; pop(x1); revert(x0, x1); return [RA]; }
:INVALID is op=0xfe { invalid(); return [RA]; }
:SELFDESTRUCT is op=0xff { local x0:32 = 0; pop(x0); selfdestruct(x0); return [RA]; }

