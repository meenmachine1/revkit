macro push(v) { SP = SP - 32; *[opstack]:32 SP = v; }
macro pop(v)  { v = *[opstack]:32 SP; SP = SP + 32; }

# A jump's tag, in the segment of the jump's own code.
jtag1: loc is h1 [ loc = (inst_start & 0xfff00000) + h1; ] { export *:1 loc; }
jtag2: loc is h2 [ loc = (inst_start & 0xfff00000) + h2; ] { export *:1 loc; }
jtag3: loc is h3 [ loc = (inst_start & 0xfff00000) + h3; ] { export *:1 loc; }
jtag4: loc is h4 [ loc = (inst_start & 0xfff00000) + h4; ] { export *:1 loc; }

