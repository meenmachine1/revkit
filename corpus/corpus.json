{
  "_doc": "Benchmark corpus definition. See corpus/README.md. Config ids are <format>-<arch>/<compiler>-<opt>; 'configs' entries are fnmatch patterns over them.",
  "externals": {
    "cjson": {
      "url": "https://github.com/DaveGamble/cJSON/archive/refs/tags/v1.7.18.tar.gz",
      "sha256": "3aa806844a03442c00769b83e99970be70fbef03735ff898f4811dd03b9f5ee5",
      "strip_components": 1,
      "license": "MIT"
    },
    "zlib": {
      "url": "https://zlib.net/fossils/zlib-1.3.1.tar.gz",
      "sha256": "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
      "strip_components": 1,
      "license": "Zlib"
    },
    "lua": {
      "url": "https://www.lua.org/ftp/lua-5.4.7.tar.gz",
      "sha256": "9fbf5e28ef86c69858f6d3d34eccc32e911c1a28b4120ff3e84aaa70cfbf1e30",
      "strip_components": 1,
      "license": "MIT"
    }
  },
  "programs": {
    "features": {
      "source": "src/features",
      "srcs": ["*.c"],
      "libs": ["m"],
      "configs": ["elf-*/*", "pe-x86_64/clang-*"]
    },
    "cjson": {
      "external": "cjson",
      "srcs": ["cJSON.c", "test.c"],
      "libs": ["m"],
      "configs": ["elf-x86_64/*", "elf-aarch64/gcc-O2", "elf-riscv64/clang-O2", "pe-x86_64/clang-O2"]
    },
    "zlib": {
      "external": "zlib",
      "srcs": ["adler32.c", "compress.c", "crc32.c", "deflate.c", "gzclose.c", "gzlib.c",
               "gzread.c", "gzwrite.c", "infback.c", "inffast.c", "inflate.c", "inftrees.c",
               "trees.c", "uncompr.c", "zutil.c", "test/minigzip.c"],
      "include": ["."],
      "cflags_by_format": {"elf": ["-D_LARGEFILE64_SOURCE=1", "-DHAVE_HIDDEN"]},
      "configs": ["elf-x86_64/gcc-O2", "elf-x86_64/clang-O0", "elf-aarch64/clang-O2", "elf-riscv64/gcc-O2"]
    },
    "lua": {
      "external": "lua",
      "srcs": ["src/*.c"],
      "exclude": ["src/luac.c"],
      "cflags_by_format": {"elf": ["-DLUA_USE_POSIX"]},
      "libs": ["m"],
      "configs": ["elf-x86_64/gcc-O2", "elf-aarch64/clang-O2"]
    }
  }
}
