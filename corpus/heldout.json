  "programs": {
    "bzip2": {
      "external": "bzip2",
      "srcs": ["blocksort.c", "huffman.c", "crctable.c", "randtable.c", "compress.c", "decompress.c",
               "bzlib.c", "bzip2.c"],
      "cflags": ["-D_FILE_OFFSET_BITS=64"],
      "configs": ["elf-*/*", "pe-x86_64/clang-*"]
    },
    "mujs": {
      "external": "mujs",
      "srcs": ["one.c", "main.c"],
      "libs": ["m"],
      "configs": ["elf-*/*", "pe-x86_64/clang-*"]
    },
    "tcc": {
      "external": "tcc",
      "srcs": ["tcc.c"],
      "generated": {"config.h": "#define TCC_VERSION \"0.9.27\"\n#define CONFIG_TCCDIR \"/usr/local/lib/tcc\"\n"},
      "cflags": ["-DONE_SOURCE=1", "-DTCC_TARGET_X86_64"],
      "cflags_by_format": {"pe": ["-DTCC_TARGET_PE"]},
      "libs_by_format": {"elf": ["m", "dl", "pthread"]},
      "configs": ["elf-x86_64/*", "elf-aarch64/gcc-O2", "elf-riscv64/clang-O2", "pe-x86_64/clang-O2"]
    },
    "mbedtls": {
      "external": "mbedtls",
      "srcs": ["library/*.c", "programs/test/selftest.c"],
      "exclude": ["library/ssl*.c", "library/x509*.c", "library/pkcs7.c", "library/debug.c",
                  "library/net_sockets.c", "library/mps_*.c"],
      "include": ["include", "library"],
      "libs_by_format": {"pe": ["bcrypt"]},
      "configs": ["elf-x86_64/gcc-O2", "elf-x86_64/clang-O0", "elf-aarch64/clang-O2", "elf-riscv64/gcc-O2",
                  "pe-x86_64/clang-O0"]
    },
    "sqlite": {
      "external": "sqlite",
      "srcs": ["sqlite3.c", "shell.c"],
      "libs": ["m"],
      "configs": ["elf-x86_64/clang-O2", "elf-aarch64/gcc-O2", "elf-riscv64/clang-O2", "pe-x86_64/clang-O2"]
    }
  }
