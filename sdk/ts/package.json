{
  "name": "@revkit/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "TypeScript client for the revkit API (Connect-ES over Connect or gRPC-web)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "buf generate",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx test/smoke.ts",
    "smoke:auth": "tsx test/auth.ts",
    "test:headers": "tsx test/headers.ts",
    "test:archives": "tsx test/archives.ts",
    "test:structures": "tsx test/structures.ts",
    "test:detect": "tsx test/detect.ts",
    "test:scripting": "tsx test/scripting.ts",
    "test:search": "tsx test/search.ts",
    "test:scripts": "tsx test/scripts.ts",
    "test:projects": "tsx test/projects.ts",
    "test:equates": "tsx test/equates.ts",
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0"
  },
  "peerDependencies": {
    "@connectrpc/connect-node": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@connectrpc/connect-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/node/index.d.ts",
      "default": "./dist/node.js"
    }
  }
}
