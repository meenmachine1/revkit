    ]
   },
   "on": {
    "features": {
     "setup": [
      {
       "op": "comment",
       "at": "main",
       "kind": "eol",
       "text": "check the secret"
      },
      {
       "op": "comment",
       "at": "fnv1a",
       "kind": "pre",
       "text": "hashes a secret value"
      },
      {
       "op": "comment",
       "at": "run_bits",
       "kind": "plate",
       "text": "twiddles the secret\nbits"
      },
      {
       "op": "comment",
       "at": "run_vm",
       "kind": "post",
       "text": "no match here"
      }
     ]
    }
   }
  },
