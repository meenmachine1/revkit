   "name": "CountSymbolsScript",
   "script": "CountSymbolsScript.py",
   "source": "Features/Base",
   "compare": [
    "output"
   ],
   "extra": true,
   "why": "lists every symbol: Ghidra's ELF loader marks up .dynamic, .eh_frame and the ELF headers with labels (__DT_*, fde_*, cie_*) revkit's loader doesn't make, so it compares the loaders more than the shim"
  },
  {
   "name": "ConvertDotToDashInAutoAnalysisLabels",
   "script": "ConvertDotToDashInAutoAnalysisLabels.py",
   "source": "Features/Base",
   "setup": [
    {
     "op": "label",
     "at": "decrypt+0x11",
     "name": "case.1",
     "source": "ANALYSIS"
    },
    {
     "op": "label",
     "at": "mix+0x4",
     "name": "kept.by.user",
     "source": "USER_DEFINED"
    }
   ],
   "compare": [
    "output",
    "names"
   ],
   "on": {
    "features": {
     "setup": [
      {
       "op": "label",
       "at": "fnv1a+0x8",
       "name": "case.1",
       "source": "ANALYSIS"
      },
      {
       "op": "label",
       "at": "run_vm+0x8",
       "name": "kept.by.user",
       "source": "USER_DEFINED"
      }
     ]
    }
   }
  },
  {
