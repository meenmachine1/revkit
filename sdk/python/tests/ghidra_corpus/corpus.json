     "op": "comment",
     "at": "decrypt",
     "kind": "plate",
     "text": "decrypts the secret\nin place"
    },
    {
     "op": "comment",
     "at": "parse_config",
     "kind": "post",
     "text": "no match here"
    }
   ],
   "args": [
    "secret",
    "SECRET"
   ],
   "compare": [
    "output",
    "comments"
   ],
   "normalize": {
