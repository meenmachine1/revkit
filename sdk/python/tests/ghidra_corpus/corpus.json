  {
   "name": "FindAndReplaceCommentScript",
   "script": "FindAndReplaceCommentScript.py",
   "source": "Features/Base",
   "setup": [
    {
     "op": "comment",
     "at": "main",
     "kind": "eol",
     "text": "check the secret"
    },
    {
